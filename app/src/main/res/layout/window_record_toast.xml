<?xml version="1.0" encoding="utf-8"?>
<!--
  后台记账的「非模态」提示卡片。

  只在静默记账（没有悬浮窗权限、直接入库）之后出现，用来告诉用户「刚才记了一笔」，
  并且给一个反悔的入口。它是非模态的：不抢焦点、不遮挡操作、4 秒后自己消失，
  用户想确认细节再点进 App。

  根布局故意是透明的 FrameLayout：窗口宽度铺满、高度按内容，卡片本身留出外边距，
  这样卡片以外的区域不会吃掉触摸事件。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_toast_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:background="#00000000">

    <LinearLayout
        android:id="@+id/record_toast_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_card"
        android:elevation="6dp"
        android:paddingLeft="16dp"
        android:paddingRight="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_toast_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="¥0.00" />

            <TextView
                android:id="@+id/tv_toast_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:text="10-01 14:30" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_toast_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:text="✕" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_toast_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:text="" />

            <TextView
                android:id="@+id/btn_toast_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/app_blue"
                android:text="撤销" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
