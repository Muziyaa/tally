# Tally 守护可调参数
#
# 用法：
#   cp /data/adb/modules/tally_a11y_guard/config.example /data/adb/tally-a11y-guard/config
#   编辑它，然后：sh /data/adb/modules/tally_a11y_guard/service.sh
#
# 全部不填 = 用下面的默认值（当前 = 「极速恢复」档）。

# ---- 守护主循环 ----
# 多久轮询一次（秒）。调大 = 更省电，但无障碍被关后恢复更慢。
POLL_SECONDS=30

# 每 N 个轮询做一次「绑定健康检查」（会执行 dumpsys accessibility，是最贵的一项）。
BIND_CHECK_EVERY=1

# 每 N 个轮询重新应用一次权限设置。
AUTOMATION_EVERY=2

# 每 N 个轮询做一次深度检查（pm list packages + 日志轮转）。
DEEP_CHECK_EVERY=10

# ---- 看护 ----
# 多久检查一次守护是否还活着（秒）。
WATCHDOG_INTERVAL=60

# ---- 三档参考 ----
# 极速恢复（默认）：POLL_SECONDS=30  BIND_CHECK_EVERY=1  AUTOMATION_EVERY=2   WATCHDOG_INTERVAL=60
#                     唤醒 4320 次/天，最坏恢复 ≤30 秒
# 平衡（推荐）      ：POLL_SECONDS=60  BIND_CHECK_EVERY=4  AUTOMATION_EVERY=10  WATCHDOG_INTERVAL=180
#                     唤醒 1920 次/天，最坏恢复 ≤60 秒
# 省电              ：POLL_SECONDS=120 BIND_CHECK_EVERY=6  AUTOMATION_EVERY=20  WATCHDOG_INTERVAL=600
#                     唤醒  864 次/天，最坏恢复 ≤2 分钟
